# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# JWT Secrets (should be 64+ char hex in production)
JWT_ACCESS_SECRET="default_access_secret_for_development_purposes_only_1234567890"
JWT_REFRESH_SECRET="default_refresh_secret_for_development_purposes_only_1234567890"

# Anthropic API Key (if user wants to use Anthropic for chatbot)
ANTHROPIC_API_KEY=""

# Supabase Configuration
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
FIREBASE_PROJECT_ID=""
